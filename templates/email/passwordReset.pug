//- passwordReset.pug
extends _baseEmail

block content
  p Hi #{firstName},
  p Forgot your password? Click the button below to set a new one.
  p This link is valid for only 10 minutes.
  table(role='presentation' cellpadding='0' cellspacing='0')
    tr
      td
        a.btn(href=url target='_blank') Reset your password
  p If you didn't request a password reset, please ignore this email.