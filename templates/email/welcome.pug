//- welcome.pug
extends _baseEmail

block content
  p Hi #{firstName},
  p Welcome to Natours, we're glad to have you 🎉
  p We're all a big family here, so make sure to upload your user photo so we get to know you a bit better!
  table(role='presentation' cellpadding='0' cellspacing='0')
    tr
      td
        a.btn(href=url target='_blank') Upload user photo
  p If you need any help with booking your next tour, please don't hesitate to contact me!
  p - Nirmalya, CEO